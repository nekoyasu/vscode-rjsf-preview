{
  "name": "rjsf-preview",
  "displayName": "RJSF Schema Preview",
  "description": "Preview JSON Schema as a React form using react-jsonschema-form",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "author": "nekoyasu@gmail.com",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rjsf-preview.showPreview",
        "title": "Open RJSF Form Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rjsf-preview.showPreview",
          "when": "resourceFilename =~ /schema.*\\.json$/ || resourceFilename =~ /.*schema\\.json$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "RJSF Schema Preview",
      "properties": {
        "rjsf-preview.defaultTheme": {
          "type": "string",
          "enum": ["default", "fluent-light", "fluent-dark"],
          "enumDescriptions": [
            "Default RJSF theme",
            "Fluent UI (Light)",
            "Fluent UI (Dark)"
          ],
          "default": "default",
          "description": "Default UI theme for the form preview"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --sourcemap",
    "build:webview": "esbuild src/webview/index.tsx --bundle --outfile=dist/webview.js --platform=browser --format=iife --sourcemap",
    "watch": "concurrently \"npm run watch:ext\" \"npm run watch:webview\"",
    "watch:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --watch",
    "watch:webview": "esbuild src/webview/index.tsx --bundle --outfile=dist/webview.js --platform=browser --format=iife --watch",
    "package": "npx --yes @vscode/vsce package --baseContentUrl https://localhost --baseImagesUrl https://localhost --allow-missing-repository --out rjsf-preview.vsix",
    "install:local": "npm run package && code --install-extension rjsf-preview.vsix --force",
    "test": "jest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "concurrently": "^8.0.0",
    "esbuild": "^0.20.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.1",
    "@fluentui/react-icons": "^2.0.298",
    "@fluentui/react-migration-v0-v9": "^9.3.10",
    "@rjsf/core": "^6.7.1",
    "@rjsf/fluentui-rc": "^6.7.1",
    "@rjsf/utils": "^6.7.1",
    "@rjsf/validator-ajv8": "^6.7.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "overrides": {
    "@fluentui/react-migration-v0-v9": {
      "@fluentui/react-northstar": "^0.71.0"
    }
  }
}
